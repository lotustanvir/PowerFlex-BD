# PowerFlex-BD Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/powerflex

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Port (default: 8000)
BACKEND_PORT=8000

# PGCB Grid Data Provider (optional - for API-based grid data)
PGCB_GRID_PROVIDER=
PGCB_GRID_API_URL=
PGCB_GRID_API_KEY=

# Application
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-me-to-a-random-secret

# Cache Configuration
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM=60

# Security
TRUSTED_HOSTS=localhost,127.0.0.1

# API Keys (format: key1:name1,key2:name2)
POWERFLEX_API_KEYS=

# Logging
LOG_LEVEL=INFO

# PostgreSQL (for Docker)
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Data Collection
ENABLE_DATA_COLLECTION=false
PGCB_POLL_INTERVAL_SECONDS=600

# PGCB SSL Verification
# PGCB ERP server may have certificate issues.
# Set to "false" for development if SSL verification fails.
# DO NOT disable in production — a warning is logged when disabled.
GRID_SSL_VERIFY=true

# Application Environment
# Set to "production" to enable API key authentication on protected routes.
# In development, all routes are open (no auth required).
APP_ENV=development
